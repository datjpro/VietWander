{
  "name": "vietwander-workspace",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:web": "npm --workspace frontend run web",
    "dev:mobile": "npm --workspace frontend run start",
    "dev:api": "npm --workspace backend run dev",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:frontend": "npm --workspace frontend run typecheck",
    "typecheck:backend": "npm --workspace backend run typecheck"
  }
}
